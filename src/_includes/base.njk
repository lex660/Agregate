<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- CSP: только свои скрипты и Яндекс.Метрика. При добавлении нового внешнего ресурса — обновить здесь. -#}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; style-src 'self' 'unsafe-inline'; frame-src blob: https://mc.yandex.ru https://mc.yandex.com; child-src blob: https://mc.yandex.ru https://mc.yandex.com; font-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#0f5c4a">
  <link rel="icon" href="{{ '/assets/img/icon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}?v={{ site.buildDate }}">
  <script src="{{ '/assets/js/metrika.js' | url }}" data-counter="{{ site.metrikaId }}" defer></script>
  {% if jsonld %}<script type="application/ld+json">{{ jsonld | json | safe }}</script>{% endif %}
</head>
<body>
  <header class="topbar">
    <div class="wrap topbar__in">
      <a class="logo" href="{{ '/' | url }}">Сравни<span>рассрочку</span></a>
      <nav class="nav" aria-label="Разделы">
        {% for r in tariffs.regions %}<a href="{{ ('/' + r.id + '/') | url }}"{% if page.url == '/' + r.id + '/' %} aria-current="page"{% endif %}>{{ r.name }}</a>{% endfor %}
        <a href="{{ '/kompanii/' | url }}"{% if page.url == '/kompanii/' %} aria-current="page"{% endif %}>Компании</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="footer">
    <div class="wrap">
      <p class="disclaimer"><strong>Важно.</strong> Сайт сравнивает публичные условия исламской рассрочки (мурабаха) и не является кредитной организацией, продавцом или представителем компаний. Расчёты справочные и не являются офертой. Окончательные условия, наценку и решение об одобрении определяет компания. Перед оформлением сверяйте условия на её сайте и в договоре.</p>
      <nav class="footer__nav" aria-label="Служебные страницы">
        <a href="{{ '/o-proekte/' | url }}">Как мы считаем</a>
        <a href="{{ '/kompanii/' | url }}">Компании и источники</a>
        <a href="{{ '/reklama/' | url }}">Реклама на сайте</a>
      </nav>
      <p class="muted">© {{ site.year }} {{ site.name }} · Данные обновлены {{ tariffs.updated_at | ruDate }}</p>
    </div>
  </footer>
  {% block scripts %}{% endblock %}
</body>
</html>
